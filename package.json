{
  "name": "pixelweave-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:production-test": "vite --mode production-test --host 127.0.0.1 --port 4177 --strictPort",
    "build:production-test": "tsc -b && vite build --mode production-test",
    "preview:production-test": "vite preview --mode production-test --host 127.0.0.1 --port 4177 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "fabric": "7.4.0",
    "lucide-react": "1.34.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
